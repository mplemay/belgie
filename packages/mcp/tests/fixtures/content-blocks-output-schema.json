{
  "$defs": {
    "Annotations": {
      "description": "Optional annotations the client can use to inform how objects are used or displayed.",
      "properties": {
        "audience": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "user",
                  "assistant"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audience"
        },
        "lastModified": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lastmodified"
        },
        "priority": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priority"
        }
      },
      "title": "Annotations",
      "type": "object"
    },
    "AudioContent": {
      "description": "Audio provided to or from an LLM.",
      "properties": {
        "_meta": {
          "anyOf": [
            {
              "additionalProperties": true,
